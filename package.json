{
  "name": "payment-integrity-reporting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:generate": "node scripts/generate-sample-data.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.mjs",
    "api": "node --env-file-if-exists=.env.local --watch-path=server server/function-api.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
