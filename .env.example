# Copy to .env.local and adjust.
# VITE_* values are baked into the React build; the rest are read by the Node API and setup script.

# ---- React app ----
# Default data source on first load: api | json | csv
VITE_DATA_SOURCE=api

# Function API. The default '/api' goes through the Vite dev/preview proxy to http://localhost:7071.
# For a deployed build set the full URL, e.g. https://<app>.azurewebsites.net/api
VITE_API_BASE_URL=/api
VITE_API_QUERY_PATH=/query
# Optional: function key sent as the x-functions-key header (leave blank if auth is handled elsewhere)
VITE_API_KEY=
VITE_API_TIMEOUT_MS=30000

# Static files served from public/data
VITE_JSON_URL=data/savings-invoice.json
VITE_CSV_URL=data/savings-invoice.csv

# Customer shown in the report header before sign-in data is available
VITE_CUSTOMER_NAME=Centene

# ---- Function API + database (npm run api / npm run db:setup) ----
DATABASE_URL=postgres://pi:pi@localhost:5432/pi
API_PORT=7071
# Allowed browser origin for direct (non-proxied) calls
CORS_ORIGIN=*
# Password given to the demo users by npm run db:setup
SEED_PASSWORD=Password123!
