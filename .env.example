# Copy to .env.local and adjust.
# VITE_* values are baked into the React build.

# ---- React app ----
VITE_DATA_SOURCE=api

# App API (auth, datasets). '/api' is proxied to :7071 except /api/v1.
# Start payment-integrity-api on :7071 first.
VITE_API_BASE_URL=/api
# Function App origin only. Path /api/v1/clients/{clientId}/financial-impact is built in code.
VITE_QUERY_API_BASE_URL=https://func-hpm-api-001.azurewebsites.net
VITE_API_KEY=
# Function host key. Sent as x-functions-key and ?code=. Restart npm run dev after changing.
VITE_QUERY_API_KEY=
# 60s: a Snowflake warehouse resume on the first query can take 10–30s
VITE_API_TIMEOUT_MS=60000
VITE_LINE_OF_BUSINESS_ID=1

VITE_JSON_URL=data/savings-invoice.json
VITE_CSV_URL=data/savings-invoice.csv
VITE_CUSTOMER_NAME=Centene

# Optional override of VITE_QUERY_API_BASE_URL for the Vite /api/v1 proxy only.
# QUERY_API_PROXY_TARGET=https://func-hpm-api-001.azurewebsites.net
# Optional host key injected by the Vite proxy so it is not required in the JS bundle.
# QUERY_API_FUNCTION_KEY=

# Vite proxy target for /api (auth + datasets). Default is the local App API.
# API_PROXY_TARGET=http://localhost:7071
