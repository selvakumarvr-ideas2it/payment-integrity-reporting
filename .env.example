# Copy to .env.local and adjust.
# VITE_* values are baked into the React build; the rest are read by the App API and setup script.

# ---- React app ----
VITE_DATA_SOURCE=api

# App API (auth + datasets). '/api' is proxied to :7071 except /api/query.
VITE_API_BASE_URL=/api
# Query API (Snowflake). Leave as /api in dev (Vite proxies /api/query to :7072).
# For Azure: the Function App or APIM URL.
VITE_QUERY_API_BASE_URL=/api
VITE_API_QUERY_PATH=/query
VITE_API_KEY=
VITE_QUERY_API_KEY=
# 60s: a Snowflake warehouse resume on the first query can take 10–30s
VITE_API_TIMEOUT_MS=60000
VITE_LINE_OF_BUSINESS_ID=1

VITE_JSON_URL=data/savings-invoice.json
VITE_CSV_URL=data/savings-invoice.csv
VITE_CUSTOMER_NAME=Centene

# ---- App API (npm run api) ----
DATABASE_URL=postgres://pi:pi@localhost:5432/pi
API_PORT=7071
CORS_ORIGIN=*
SEED_PASSWORD=Password123!
