# Copy to .env.local and adjust.
# VITE_* values are baked into the React build; the rest are read by the Node API and setup script.

# ---- React app ----
# Default data source on first load: api | json | csv
VITE_DATA_SOURCE=api

# Function API. The default '/api' goes through the Vite dev/preview proxy to http://localhost:7071.
# For a deployed build set the full URL, e.g. https://<app>.azurewebsites.net/api
VITE_API_BASE_URL=/api
VITE_API_QUERY_PATH=/query
# Optional: function key sent as the x-functions-key header (leave blank if auth is handled elsewhere)
VITE_API_KEY=
# 60s: a Snowflake warehouse resume on the first Function API query can take 10–30s
VITE_API_TIMEOUT_MS=60000

# Static files served from public/data
VITE_JSON_URL=data/savings-invoice.json
VITE_CSV_URL=data/savings-invoice.csv

# Customer shown in the report header before sign-in data is available
VITE_CUSTOMER_NAME=Centene

# ---- Function API + database (npm run api / npm run db:setup) ----
DATABASE_URL=postgres://pi:pi@localhost:5432/pi
API_PORT=7071
# Allowed browser origin for direct (non-proxied) calls
CORS_ORIGIN=*
# Password given to the demo users by npm run db:setup
SEED_PASSWORD=Password123!

# Query API backend: snowflake (Function API tab) or postgres (local rollback)
BI_ENGINE_BACKEND=snowflake
# Line of business sent on every Snowflake payload (must match 04_seed_savings_invoice.sql)
LINE_OF_BUSINESS_ID=1

# ---- Snowflake (required when BI_ENGINE_BACKEND=snowflake) ----
# Use the org-account identifier, NOT the locator (HH07160 404s on login).
# In Snowsight: SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=
# Optional full host if the identifier is not enough:
# SNOWFLAKE_ACCESS_URL=https://myorg-myaccount.snowflakecomputing.com
SNOWFLAKE_USER=
# Password auth (dev) OR key-pair (preferred). Set one of:
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=C:\path\to\rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=PI_BI_WH
# SYSADMIN owns the objects in the no-custom-roles setup; use PI_BI_API once that role exists
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_DATABASE=PI
SNOWFLAKE_SCHEMA=BI_ENGINE
